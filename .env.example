APP_ENV=demo
LOG_LEVEL=INFO

# OpenAI-compatible chat completion API. Include /v1 when your gateway requires it.
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_API_KEY=change-me
LLM_MODEL=qwen-plus
LLM_TIMEOUT_SECONDS=30

# Local BGE embedding model.
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu

# Local PostgreSQL instance. Replace the demo credentials outside development.
POSTGRES_DSN=postgresql+asyncpg://agent_ro:agent_ro@127.0.0.1:5432/enterpriseAgent

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=enterprise-agent-local
JWT_AUDIENCE=enterprise-agent-api

CHROMA_PATH=./data/chroma
DEMO_DOCS_PATH=./app/resources/demo_docs
ROUTER_CONFIDENCE_THRESHOLD=0.70
TOP_K=5
CHUNK_SIZE=600
CHUNK_OVERLAP=100
RETRIEVAL_MIN_SCORE=0.20
SQL_TIMEOUT_SECONDS=3
SQL_MAX_ROWS=200
